(function ($, Drupal, drupalSettings) {


Drupal.behaviors.descargaTabla = {
  attach: function (context, settings) {

    function idGenerator() {
      if (typeof window.gincremento == 'undefined') {
        window.gincremento = 1;
      } else {
        window.gincremento = 1 * window.gincremento;
      }
      window.gincremento = window.gincremento + 1;
      var S4 = function () {
        return (((1 + Math.random()) * 0x10000) | 0).toString(16).substring(1);
      };
      return ("G_" + window.incremento + "_" + S4() + S4() + S4());
    }

    $('table[data-download]:not(.dlprocesada)').each(function () {
      idx = idGenerator();
      $(this).addClass('dlprocesada');
      nvtabla = $(this).clone();
      $(nvtabla).attr("id", 'dl_' + idx);
      $(nvtabla).css("display", 'table');
      var titulo = $(this).find('caption').text();
      var strVar = "";
      // obtenemos la fecha de descarga
      var hoy = new Date();
      var dd = hoy.getDate();
      var mm = hoy.getMonth() + 1;
      var yyyy = hoy.getFullYear();
      var hoy = dd + '/' + mm + '/' + yyyy;
      //agregamos contenido adicional al archivo
      var tabla_footer = "<tr></tr><tr><td colspan='2'>Documento obtenido de:</td></tr><tr><td colspan='2'>www.sspa.juntadeandalucia.es/servicioandaluzdesalud/</td></tr><tr><td colspan='2'>Fecha de descarga: " + hoy + "</td></tr>";

      var tfoot = $(nvtabla).find('tfoot');
      if (tfoot.length) {
        //console.log("hay tfoot");
        $(nvtabla).find('tfoot').append(tabla_footer);
      } else {
        //console.log("no hay tfoot");
        $(nvtabla).find('tbody').append(tabla_footer);
      }

      //$(nvtabla).find('tbody').append(tabla_footer);
      captiontext = $(nvtabla).find('caption').text();
      //$(nvtabla).find('caption').html('<img src="data:image/png;base64," style="float:left;margin-bottom:16px;"><span style="float:left;clear:left">'+captiontext+'</span>');
      //$(nvtabla).find('caption').css("");
      //$(nvtabla).find('thead').prepend('<tr><th>'.captiontext.'</th></tr>');
      $('body').append('<div id="wrapper-' + idx + '" style="display:none;"></div>');
      $('#wrapper-' + idx).append(nvtabla);
      var formatos = ($(this).attr('data-download')).split(',');
      strVar += "<p>Descargar datos en formato";
      lista = "";
      for (i = 0; i < formatos.length; i++) {
        if (formatos[i].trim() == 'true') {
          lista += " <a href=\"#\" onclick=\"Exporter.export(document.getElementById('dl_" + idx + "'), 'tabla_" + titulo + ".xls', 'Estadísticas');return false;\"> xls<\/a> | <a href=\"#\" onclick=\"Exporter.export(document.getElementById('dl_" + idx + "'), 'tabla_" + titulo + ".csv', 'Estadísticas');return false;\"> csv<\/a> ";
        }
      }
      strVar += lista + "<\/p>";
      //document.getElementById('resultado-'+idx).innerHTML = strVar;
      $(this).before(strVar);
    });
    // DR 20.02.2019
    $('.node--type-sastipoestadistica.node--view-mode-full h2.node__title a').removeAttr('href');

    $(window).on("load", function () {
      // en caso de tabla que muestra el grafico se duplica el enlace de download, de momento lo escondo asi...
      $('.field--name-sas-tipoestadistica-tabla div[id] > p').hide();
    });

  }
};

})(jQuery, Drupal, drupalSettings);
