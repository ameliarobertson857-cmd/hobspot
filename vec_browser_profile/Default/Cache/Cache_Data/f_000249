      function iconcollection(icondataurl, w, h, scale, icobox, icosize, defecto) {
        //Coordenadas de un icono:
        var i = 0;
        var iconos = new Array();
        iconos[0] = null;
        for (var y = 0; y < h; y = y + icobox * scale) {
          for (var x = 0; x < w; x = x + icobox * scale) {
            iconos.push(new ol.style.Icon({
              offset: [x, y],
              opacity: 1,
              rotateWithView: false,
              rotation: 0.0,
              scale: 1 / scale,
              size: [icosize * scale, icosize * scale],
              crossOrigin: 'anonymous',
              src: icondataurl
            }));
          }
        }
        iconos[0] = iconos[defecto];
        return iconos;
      }

      function rendermap(opciones) {
