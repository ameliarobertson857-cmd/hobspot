        var view = new ol.View(viewdata);
        var jqcontainer = $('<div class="mapsas-popup"></div>'); //document.getElementById('popup');
        var jqcontent = $('<div class="mapsas-popup-content"></div>'); //document.getElementById('popup-content');
        var jqcloser = $('<a href="#" class="mapsas-popup-closer"></a>'); //document.getElementById('popup-closer');
