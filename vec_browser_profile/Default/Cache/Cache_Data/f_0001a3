  /**
   * Menu hamburger al lado de título de página.
   * muestra solo segundos y terceros niveles.
   * los segundos niveles que tienen hijos están cerrados y se abren con el click en la flecha roja a la derecha.
   *
   * Se usa lo mismo para un bloque estatico para las utilidades (normativa, enlaces interes, estadisticas) y otro
   * bloque para los enlaces del pie (sitemap, aviso legal, ...)
   */
  Drupal.behaviors.hamburger = {
    attach: function (context, settings) {

      // añado uno <span> para abrir/cerrar solo en los enlaces que tienen hijos
      $('#hamburger_menu-wrapper ul.menu > li.menu-item--expanded > a').once().each(function () {
        $('<span class="expande-hijos">&nbsp;</span>').insertAfter(this);
      });

      $('#hamburger_menu-wrapper ol.menu > li.menu-item--expanded > a').once().each(function () {
        $('<span class="expande-hijos">&nbsp;</span>').insertAfter(this);
      });

      // escondo los hijos
      $('#hamburger_menu-wrapper ul.menu > li.menu-item--expanded ul.menu').hide();
      // al click <span class="expande-hijos"> muestro los terceros niveles
      $('#hamburger_menu-wrapper .expande-hijos').once().click(function () {
        $(this).toggleClass('cierra-hijos');
        $(this).siblings('ul.menu').slideToggle();
      });

      $('#hamburger_menu-wrapper ol.menu > li.menu-item--expanded ol.menu').hide();
      // al click <span class="expande-hijos"> muestro los terceros niveles
      $('#hamburger_menu-wrapper .expande-hijos').once().click(function () {
        $(this).toggleClass('cierra-hijos');
        $(this).siblings('ol.menu').slideToggle();
      });

      if ($('#hamburger_menu-wrapper').length) {
        $('#hamburger_menu-wrapper').hide();
        $('.layout-no-sidebars h1.page-title').once().prepend('<button id="sas-hamburger" class="hamburger hamburger--squeeze" type="button"><span class="hamburger-box"><span class="hamburger-inner"></span></span></button><button id="hider-sas-hamburger" class="hamburger hamburger--squeeze" type="button"><span class="hamburger-box"><span class="hamburger-inner"></span></span></button>');
        // en cartera servicio el hamburguesa esta en otra posicion
        $('.layout-sidebar-first .csap-title').once().prepend('<button id="sas-hamburger" class="hamburger hamburger--squeeze" type="button"><span class="hamburger-box"><span class="hamburger-inner"></span></span></button>');
      }


      $('#sas-hamburger').once().on("click", function (e) {
        e.preventDefault();
        if ($(this).hasClass('hamburger-abierto')) { // esta abierto?
          $(this).removeClass('hamburger-abierto');
          $('body').removeClass('hamburger-abierto');
          $('#hamburger_menu-wrapper').slideUp();
        } else { // esta cerrado
          $(this).addClass('hamburger-abierto');
          $('body').addClass('hamburger-abierto');
          $('#hamburger_menu-wrapper').slideDown();
          $(this).hide();
          $('#hider-sas-hamburger').show();
        }
      });
      $('#hider-sas-hamburger').once().on("click", function (v) {
        v.preventDefault();
        $(this).hide();
        $('#sas-hamburger').show();
      });


      $(document).mouseup(function (h) { // clic en cualquier punto de la pagina
        var container = $('#hamburger_menu-wrapper');
        if ($('body').hasClass('hamburger-abierto') && !container.is(h.target) && container.has(h.target).length === 0) {
          container.slideUp();
          $('body').removeClass('hamburger-abierto');
          $('#sas-hamburger').removeClass('hamburger-abierto').show();
          $('#hider-sas-hamburger').hide();
        }
      });
      $(document).keydown(function (h) { // tecla esc
        if (h.keyCode === 27 && $('body').hasClass('hamburger-abierto')) {
          $('#hamburger_menu-wrapper').slideUp();
          $('body').removeClass('hamburger-abierto');
          $('#sas-hamburger').removeClass('hamburger-abierto').show();
          $('#hider-sas-hamburger').hide();
        }
      });
    }
  };

