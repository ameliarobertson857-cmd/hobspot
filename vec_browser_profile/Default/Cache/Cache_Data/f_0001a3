        mensaje.style.cssText = "position: absolute; top: 100%; right: 0; margin-top: 15px; background: #087021; color: white; padding: 8px 12px; border-radius: 4px; display: none; z-index: 1000; font-size: 14px; white-space: nowrap; box-shadow: 0 2px 5px rgba(0,0,0,0.2);";
        compartirEnlace.style.position = "relative";
        compartirEnlace.appendChild(mensaje);
      }

      const baseUrl = "https://www.sspa.juntadeandalucia.es/servicioandaluzdesalud";
      let currentPath = window.location.pathname + window.location.search + window.location.hash;

      if (currentPath.startsWith("/servicioandaluzdesalud")) {
        currentPath = currentPath.substring("/servicioandaluzdesalud".length);
      }

      const url = baseUrl + currentPath;

      // Intentar copiar con detección automática
      copyTextToClipboard(url)
        .then(() => {
          mensaje.textContent = "Enlace copiado";
          mensaje.style.background = "#087021";
          mensaje.style.display = "block";
          setTimeout(() => mensaje.style.display = "none", 2000);
        })
        .catch(err => {
          console.error("Error copiando:", err);
          mensaje.textContent = "Error al copiar";
          mensaje.style.background = "#f44336";
          mensaje.style.display = "block";
          setTimeout(() => mensaje.style.display = "none", 2000);
        });
    }
  });

  // Función universal de copiado
  async function copyTextToClipboard(text) {
    // Método moderno (para HTTPS)
    if (navigator.clipboard && window.isSecureContext) {
      return await navigator.clipboard.writeText(text);
    }
    // Método legacy (para HTTP o navegadores antiguos)
    else {
      return new Promise((resolve, reject) => {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.cssText = 'position:fixed;left:-9999px;opacity:0;';
        document.body.appendChild(textArea);
        textArea.select();
        try {
          document.execCommand('copy');
          document.body.removeChild(textArea);
          resolve();
        } catch (err) {
          document.body.removeChild(textArea);
          reject(err);
        }
      });
    }
  }
});

