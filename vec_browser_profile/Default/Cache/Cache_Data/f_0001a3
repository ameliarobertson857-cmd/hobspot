/* Apretura y cierre del menú responsive */

(function ($, Drupal) {
  Drupal.behaviors.responsiveOffCanvas = {
    attach: function (context, settings) {
      const $toggle = $('#toggle-icon', context);
      const $menu = $('.off-canvas-wrapper', context);

      // Evitamos volver a asignar los eventos si ya están
      if (!$toggle.data('initialized')) {

        // Función para abrir/cerrar menú
        const toggleMenu = function (e) {
          e.preventDefault();
          if ($menu.is(':visible')) {
            $menu.hide();
            $toggle.removeClass('active');
          } else {
            $menu.show();
            $toggle.addClass('active');
          }
        };

        // Click en toggle
        $toggle.once('responsiveOffCanvas').on('click', toggleMenu);
        $toggle.data('initialized', true);

        // Click fuera del menú
        $(document).once('responsiveOffCanvasClick').on('click', function (event) {
          if (!$menu.is(event.target) && $menu.has(event.target).length === 0 &&
            !$toggle.is(event.target)) {
            $menu.hide();
            $toggle.removeClass('active');
          }
        });
      }
    }
  };
})(jQuery, Drupal);

