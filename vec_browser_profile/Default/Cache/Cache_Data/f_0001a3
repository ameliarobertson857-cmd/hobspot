        const button = document.getElementById("download-xls-button");

        // Si el botón ya tiene el event listener, no lo volvemos a agregar
        if (button && !button.hasAttribute("data-listener-added")) {
          button.setAttribute("data-listener-added", "true");  // Marcamos el botón para indicar que ya tiene el listener

          button.addEventListener("click", function handleDownloadClick() {
            // Deshabilitar el botón para evitar más clics
            button.disabled = true;

            // Capturar solo los elementos con la clase 'view-grouping'
            let elements = document.querySelectorAll(".view-grouping");
            let htmlContent = "";
            let namecartera = document.querySelector(".view-grouping-header").textContent.trim();

            elements.forEach(el => {
              let boton = el.querySelector(".volver-button");
              if (boton) {
                //boton.remove(); // Elimina el botón si lo encuentra
              }
              htmlContent += el.outerHTML; // Agregar cada div con clase 'view-grouping'
            });

            if (htmlContent.trim() === "") {
              alert("No hay contenido para exportar.");
              button.disabled = false;  // Volver a habilitar el botón si no hay contenido
              return;
            }

            // Enviar al backend de Drupal
            fetch('/descarga-cartera', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({ html_content: htmlContent })
            })
              .then(response => response.blob())  // Recibe el archivo como Blob
              .then(blob => {
                let a = document.createElement("a");
                a.href = URL.createObjectURL(blob);
                a.download = namecartera + ".xls";  // Nombre del archivo
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
              })
              .catch(error => console.error("Error al descargar el archivo:", error))
              .finally(() => {
                // Deshabilitar el botón y evitar más clics
                button.disabled = false;
              });
          });
        }
