document.addEventListener('DOMContentLoaded', function () {
  const specificUrl = '/servicioandaluzdesalud/profesionales/relacion-con-la-ciudadania/precios-publicos';

  if (window.location.pathname.startsWith(specificUrl)) {
    const targetNode = document.body;
    const config = { childList: true, subtree: true };

    const adjustColumnWidths = () => {
      const tables = document.querySelectorAll('table.views-table');

      tables.forEach(table => {
        const priceCells = table.querySelectorAll('.views-field-sas-preciopublico-precio');
        let maxLength = 0;

        priceCells.forEach(cell => {
          const text = cell.innerText.trim();
          if (text.length > maxLength) {
            maxLength = text.length;
          }
        });

        const priceHeader = table.querySelector('th.views-field-sas-preciopublico-precio');
        if (priceHeader) {
          priceHeader.style.width = `${maxLength + 5}ch`;
          priceHeader.style.textAlign = 'center'; // Alinear a la izquierda
        }

        priceCells.forEach(cell => {
          cell.style.width = `${maxLength + 5}ch`;
          cell.style.textAlign = 'center'; // Alinear a la izquierda
        });
      });
    };

    const callback = function (mutationsList, observer) {
      // Comprobar y eliminar <p> duplicados dentro de <div class="view-grouping-header">
      const groupingHeaders = document.querySelectorAll('.view-grouping-header');
      const seenTexts = new Set();

      groupingHeaders.forEach(header => {
        const paragraphs = header.querySelectorAll('p');
        paragraphs.forEach(paragraph => {
          const text = paragraph.innerText.trim();
          if (seenTexts.has(text)) {
            paragraph.remove();
          } else {
            seenTexts.add(text);
          }
        });
      });

      // Comprobar y vaciar <caption> duplicados dentro de <div class="view-grouping-content">
      const groupingContents = document.querySelectorAll('.view-grouping-content');
      groupingContents.forEach(content => {
        const caption = content.querySelector('caption');
        if (caption) {
          const captionText = caption.innerText.trim();
          if (seenTexts.has(captionText)) {
            caption.innerText = ''; // Vaciar el contenido del caption
          }
        }
      });

      // Ajustar el ancho de las columnas de precio
      adjustColumnWidths();
    };

    const observer = new MutationObserver(callback);
    observer.observe(targetNode, config);

    // Initial call to handle already present elements
    callback();
  }
});


