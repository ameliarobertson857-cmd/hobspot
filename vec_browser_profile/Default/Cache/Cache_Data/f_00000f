          $('#pre-bottom').append(html);
        }
      }
      if ($('#block-sastweakblock').length && $('.added-counter').length) {
        var url = window.location.pathname;
        var xhttp = new XMLHttpRequest();
        xhttp.onreadystatechange = function() {
          if (this.readyState == 4 && this.status == 200) {
            var nvis = this.responseText.split(";");
            if(nvis[1] == -1){
              $('#numberVisits').closest("#block-sastweakblock").html('');
            }
            else{
              $('#numberVisits').text(" "+nvis[1])
            }
          }
        };
        xhttp.open("GET", "/servicioandaluzdesalud/api/contador-visitas?sec=" + url, true);
        xhttp.send();
      }
   });

})(jQuery, Drupal);
// Fin contador de visitas

