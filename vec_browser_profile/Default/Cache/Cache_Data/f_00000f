(function($, Drupal) {

  'use strict';
  $(document).ready(function() {
      if (!$('#block-sastweakblock').length) {
        if (0 || window.location.pathname  == '/servicioandaluzdesalud/proveedores/contratacion-publica/compra-publica-de-innovacion/diagnostico-y-tratamiento-de-precision-en-enfermedades-infecciosas-y-cancer-asurant-y-biopsia') {
