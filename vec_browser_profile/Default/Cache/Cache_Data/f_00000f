// Solucionar bug de menu hamburguesa naranja
const navElement = document.getElementById('block-navegacionprincipal-2');
function cambiarOlPorUl(elemento) {
    if (!elemento || elemento.nodeType !== 1) {
        console.warn('El elemento proporcionado no es válido.');
        return;
    }
    const listasOrdenadas = elemento.querySelectorAll('ol.menu.sin-numeracion');
    listasOrdenadas.forEach(listaOrdenada => {
        const listaDesordenada = document.createElement('ul');
        listaDesordenada.className = listaOrdenada.className;
        while (listaOrdenada.firstChild) {
            listaDesordenada.appendChild(listaOrdenada.firstChild);
        }
        listaOrdenada.parentNode.replaceChild(listaDesordenada, listaOrdenada);
    });
    elemento.querySelectorAll('li').forEach(li => {
        cambiarOlPorUl(li);
    });
}
// Fin solucionar bug de menu hamburguesa naranja

// Llama a la función para cambiar las listas dentro del nav
