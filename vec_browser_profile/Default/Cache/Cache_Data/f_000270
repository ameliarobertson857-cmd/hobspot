}

.pie {
	width: 100%;
	height: 80px; /* Height of the footer */
	background-color: #EEEEEE;
	float: right;
	text-align: right;
	font-family: Arial, Helvetica, sans-serif;
	position: relative;
}

.pie .container {
	margin-top: 1px;
	width: calc(100% - 40px);
	margin-left: auto;
	margin-right: auto;
	position: absolute;
	font-size: 18px;
	top: 30px;
	color: #1F4A76;
	background: none;
	box-shadow: inherit;
}

.pie .version{
	margin-top: 2px;
	margin-right: 2px;
	position: relative;
	font-size: 10px;
	top: 80%;
	color: #1F4A76;
	background: none;
	box-shadow: inherit;
}

#menuPanel {
	-webkit-box-shadow: inset 10px 7px 138px -11px rgba(0, 0, 0, 0.4);
	-moz-box-shadow: inset 10px 7px 138px -11px rgba(0, 0, 0, 0.4);
	box-shadow: inset 20px 0px 40px -11px rgba(0, 0, 0, 0.1);
